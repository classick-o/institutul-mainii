# ═══════════════════════════════════════════════════════════
# Institutul Mâinii — configurare Apache/LiteSpeed pentru Hostico
# Se urcă în public_html, lângă fișierele exportate.
# ═══════════════════════════════════════════════════════════

# ── HTTPS și un singur domeniu canonic ─────────────────────
# Fără asta, site-ul răspunde și pe http:// și pe www., iar Google le vede
# ca patru site-uri diferite cu același conținut.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Exportul Next produce foldere cu index.html (/despre/index.html).
  # Cererea /despre trebuie să ajungă la /despre/, altfel se pierd căile
  # relative din pagină.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# ── Pagina de eroare ───────────────────────────────────────
ErrorDocument 404 /404.html

# ── Anteturi de securitate ─────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  # Site static, fără scripturi externe: politica poate fi strictă.
  # `unsafe-inline` la style e necesar pentru stilurile inline din pagini,
  # iar la script pentru datele de hidratare pe care le pune Next.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  # HSTS: pornește-l după ce confirmi că totul merge pe https.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Cache ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Fișierele din /_next/static au hash în nume: se pot cachea la nesfârșit.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  # HTML-ul trebuie revalidat, altfel clientul vede versiunea veche după update.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ── Protecția configurării formularului ────────────────────
# config.php conține parola căsuței de email și nu trebuie să fie citibil.
<FilesMatch "^(config|config\.example)\.php$">
  Require all denied
</FilesMatch>

# Fără listare de directoare
Options -Indexes
